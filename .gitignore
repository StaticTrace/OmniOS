# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.pythonlibs/

# ── Build artifacts ───────────────────────────────────────────────────────────
dist/
build/
*.so

# ── JS / Node ─────────────────────────────────────────────────────────────────
node_modules/

# ── Caches ────────────────────────────────────────────────────────────────────
.cache/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.parcel-cache/

# ── Replit internals ──────────────────────────────────────────────────────────
.local/
.agents/
.upm/
replit.nix
.replit

# ── Secrets — never commit the live .env (use .env.example as the template) ──
.env

# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Project-generated archives ────────────────────────────────────────────────
zipFile.zip
omnios-hub.zip
*.zip

# ── OmniOS user data & generated files ───────────────────────────────────────
# These are runtime-generated files that contain personal data or can be large.
# The config files (.omnios-defaults.json, .omnios-config.json, etc.) are
# intentionally committed so your settings travel with the repo — exclude them
# here only if you want a clean "factory default" repo for others to clone.
.omnios-logs.jsonl
.omnios-snapshots/

# ── Prompt / agent scratch files ──────────────────────────────────────────────
attached_assets/
