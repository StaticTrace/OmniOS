# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token — increases API rate limit and enables private repo access.
# Required scopes: public_repo (public repos) or repo (private repos).
# Create one at: https://github.com/settings/tokens
GITHUB_PAT=

# ── AI Providers ──────────────────────────────────────────────────────────────
# Add the key(s) for whichever provider(s) you use in the AI Assistant.
# You can also add/remove these from the Connections page inside OmniOS.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_KEY=

# Custom OpenAI-compatible endpoint key (e.g. Groq, Together, local Ollama)
CUSTOM_AI_KEY=

# ── YouTube ───────────────────────────────────────────────────────────────────
# YouTube Data API v3 key — used by the Notifications feed.
# Create one at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
